{
  "name": "@ongem/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "migrations"],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations --no-verbose",
    "migrate:create": "node-pg-migrate create -m migrations -j sql"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
